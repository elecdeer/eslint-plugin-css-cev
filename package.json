{
  "name": "eslint-plugin-css-cev",
  "version": "0.0.0",
  "description": "ESLint plugin enforcing the CEV (Component / Element / Variant) CSS architecture for @eslint/css",
  "keywords": [
    "cev",
    "css",
    "css-modules",
    "eslint",
    "eslint-plugin",
    "rscss"
  ],
  "homepage": "https://github.com/elecdeer/eslint-plugin-css-cev#readme",
  "bugs": {
    "url": "https://github.com/elecdeer/eslint-plugin-css-cev/issues"
  },
  "license": "MIT",
  "author": "elecdeer <dev@elecdeer.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elecdeer/eslint-plugin-css-cev.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@eslint/core": "^1.2.1",
    "@eslint/css": "^2.0.1",
    "@eslint/css-tree": "^4.1.2",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@eslint/css": ">=1.0.0",
    "eslint": ">=9.15.0"
  },
  "packageManager": "pnpm@11.13.1"
}
